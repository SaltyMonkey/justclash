#!/bin/sh
# Ash isn't supported properly in spellcheck static analyzer
# Using debian based version (kind of similar)
# shellcheck shell=dash
[ -f /etc/config/justclash ] || exit 0

# shellcheck disable=SC1091
if ! . /usr/lib/justclash/config/reset.sh ||
    ! config_credentials_ensure_file /etc/config/justclash; then
    logger -p user.err -t justclash "Failed to initialize service credentials."
    exit 1
fi

add_missing_option() {
    local path="$1"
    local default_value="$2"

    if ! uci -q get "$path" >/dev/null; then
        uci set "$path"="$default_value"
    fi
}

clean_fake_ip_list() {
    local option="$1"
    local list_val item new_val
    local need_clean=0

    list_val=$(uci -q get "justclash.proxy.$option")
    [ -n "$list_val" ] || return 0

    for item in $list_val; do
        case "$item" in
        +.*)
            need_clean=1
            break
            ;;
        esac
    done

    [ "$need_clean" = "1" ] || return 0

    uci -q delete "justclash.proxy.$option"
    for item in $list_val; do
        new_val="${item#+.}"
        uci add_list "justclash.proxy.$option=$new_val"
    done
}

dnsmasq_option_matches_legacy_backup() {
    local section="$1" prefix="$2" option="$3"
    local saved current

    saved=$(uci -q get "${section}.${prefix}_${option}") || return 1
    [ -n "$saved" ] || return 1
    if [ "$saved" = "unset" ]; then
        ! uci -q get "${section}.${option}" >/dev/null 2>&1
        return "$?"
    fi
    current=$(uci -q get "${section}.${option}") || return 1
    [ "$current" = "$saved" ]
}

dnsmasq_restart_if_running() {
    pidof dnsmasq >/dev/null 2>&1 || return 0
    if [ ! -x /etc/init.d/dnsmasq ] ||
        ! /etc/init.d/dnsmasq restart >/dev/null 2>&1; then
        logger -p user.err -t justclash "Failed to restart Dnsmasq after legacy backup recovery."
        return 1
    fi
}

delete_legacy_dnsmasq_backup() {
    local section="$1" prefix="$2" field

    for field in server noresolv cachesize; do
        if uci -q get "${section}.${prefix}_${field}" >/dev/null 2>&1; then
            uci -q delete "${section}.${prefix}_${field}" || return 1
        fi
    done
}

restore_legacy_dnsmasq_backup() {
    local section='dhcp.@dnsmasq[0]' prefix='justclash'
    local field option saved server current_server saved_server listen_port upstream
    local legacy_backup=0

    # A current-format snapshot, active or inactive, needs no archaeology.
    if uci -q get "${section}.${prefix}_applied" >/dev/null 2>&1; then
        return 0
    fi

    for field in server noresolv cachesize; do
        if uci -q get "${section}.${prefix}_${field}" >/dev/null 2>&1; then
            legacy_backup=1
        fi
    done
    [ "$legacy_backup" = "1" ] || return 0

    # Mixed old/new metadata is not a format; it is evidence of an interrupted
    # write. Leave it alone so runtime recovery can fail safely and loudly.
    for field in state applied_server server_present noresolv_present cachesize_present; do
        if uci -q get "${section}.${prefix}_${field}" >/dev/null 2>&1; then
            logger -p user.err -t justclash "Incomplete Dnsmasq recovery metadata preserved."
            return 0
        fi
    done

    # Legacy versions always saved both scalar options, using "unset" when the
    # original option did not exist.
    for option in noresolv cachesize; do
        saved=$(uci -q get "${section}.${prefix}_${option}") || {
            logger -p user.err -t justclash "Incomplete legacy Dnsmasq backup preserved."
            return 0
        }
        [ -n "$saved" ] || {
            logger -p user.err -t justclash "Incomplete legacy Dnsmasq backup preserved."
            return 0
        }
    done

    listen_port=$(uci -q get justclash.proxy.dns_listen_port) || {
        logger -p user.err -t justclash "Cannot identify the legacy Dnsmasq upstream; backup preserved."
        return 0
    }
    upstream="127.0.0.1#${listen_port}"
    current_server=$(uci -q get "${section}.server") || current_server=""

    if [ "$current_server" = "$upstream" ] &&
        [ "$(uci -q get "${section}.noresolv")" = "1" ] &&
        [ "$(uci -q get "${section}.cachesize")" = "0" ]; then
        saved_server=$(uci -q get "${section}.${prefix}_server") || saved_server=""
        case "$saved_server" in
        *\'*)
            logger -p user.err -t justclash "Unsupported legacy Dnsmasq server list; backup preserved."
            return 0
            ;;
        esac

        uci -q delete "${section}.server" || return 1
        if [ -n "$saved_server" ]; then
            set -f
            for server in $saved_server; do
                uci add_list "${section}.server=${server}" || return 1
            done
            set +f
        fi

        for option in noresolv cachesize; do
            saved=$(uci -q get "${section}.${prefix}_${option}") || return 1
            if [ "$saved" = "unset" ]; then
                uci -q delete "${section}.${option}" || return 1
            else
                uci set "${section}.${option}=${saved}" || return 1
            fi
        done

        uci commit dhcp || return 1
        dnsmasq_restart_if_running || return 1
        delete_legacy_dnsmasq_backup "$section" "$prefix" || return 1
        uci commit dhcp || return 1
        logger -p user.notice -t justclash "Restored and removed the active legacy Dnsmasq backup."
        return 0
    fi

    # A clean legacy stop restored both scalar values and consumed its server
    # snapshot. Recognize that stale state too, so an already stopped service
    # does not demand a ceremonial manual cleanup after upgrade.
    if dnsmasq_option_matches_legacy_backup "$section" "$prefix" noresolv &&
        dnsmasq_option_matches_legacy_backup "$section" "$prefix" cachesize; then
        if saved_server=$(uci -q get "${section}.${prefix}_server"); then
            [ "$current_server" = "$saved_server" ] || {
                logger -p user.err -t justclash "Ambiguous legacy Dnsmasq backup preserved."
                return 0
            }
        fi
        dnsmasq_restart_if_running || return 1
        delete_legacy_dnsmasq_backup "$section" "$prefix" || return 1
        uci commit dhcp || return 1
        logger -p user.notice -t justclash "Removed an inactive legacy Dnsmasq backup."
        return 0
    fi

    logger -p user.err -t justclash "Ambiguous legacy Dnsmasq backup preserved."
    return 0
}

restore_legacy_dnsmasq_backup || exit 1

# Keep blocking enabled when retiring the firewall REJECT mode.
for option in nft_quic_mode nft_dot_mode nft_doh_mode nft_dot_quic_mode; do
    if [ "$(uci -q get "justclash.settings.$option")" = "REJECT" ]; then
        uci set "justclash.settings.$option=DROP" || exit 1
    fi
done

if uci -q get justclash.settings.nft_apply_changes_router >/dev/null 2>&1; then
    uci -q delete justclash.settings.nft_apply_changes_router || exit 1
fi

add_missing_option "justclash.settings.routing_mode" "partial"
add_missing_option "justclash.settings.mihomo_core_source_type" "github"
add_missing_option "justclash.settings.mihomo_github_repo" "MetaCubeX/mihomo"
add_missing_option "justclash.settings.mihomo_github_channel" "alpha"
add_missing_option "justclash.settings.mihomo_custom_core_url" ""
add_missing_option "justclash.settings.mihomo_rulesets_files_download_url" "https://cdn.jsdelivr.net/gh/saltymonkey/mrs-parsed-data"
add_missing_option "justclash.settings.mihomo_dashboard_zashboard_url" "https://github.com/Zephyruso/zashboard/releases/latest/download/dist-no-fonts.zip"
add_missing_option "justclash.settings.mihomo_dashboard_metacubexd_url" "https://github.com/MetaCubeX/metacubexd/archive/refs/heads/gh-pages.zip"
add_missing_option "justclash.settings.mihomo_dashboard_yacd_meta_url" "https://github.com/MetaCubeX/Yacd-meta/archive/refs/heads/gh-pages.zip"
add_missing_option "justclash.settings.wait_for_wan" "0"
add_missing_option "justclash.settings.wait_for_wan_max" "90"
add_missing_option "justclash.settings.mihomo_mem_limit" "0"
add_missing_option "justclash.settings.mihomo_gogc" "0"
add_missing_option "justclash.settings.mihomo_gomaxprocs" "0"
add_missing_option "justclash.settings.nft_doh_mode" "BY RULES"
add_missing_option "justclash.settings.nft_dns_udp_mode" "BY RULES"
add_missing_option "justclash.settings.mihomo_service_data_autoupdate" "0"
add_missing_option "justclash.settings.mihomo_cron_service_data_update_string" "0 4 * * 0"
add_missing_option "justclash.settings.mihomo_scheduled_work" "0"
add_missing_option "justclash.settings.mihomo_cron_scheduled_work_start_string" "0 5 * * *"
add_missing_option "justclash.settings.mihomo_cron_scheduled_work_stop_string" "0 23 * * *"
add_missing_option "justclash.proxy.sniffer_override_destination" "0"
add_missing_option "justclash.proxy.api_tls" "0"
add_missing_option "justclash.proxy.api_tls_cert" "/etc/justclash/api-cert.pem"
add_missing_option "justclash.proxy.api_tls_key" "/etc/justclash/api-key.pem"
add_missing_option "justclash.settings.mihomo_geosite_url" "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geosite.dat"
add_missing_option "justclash.settings.mihomo_geoip_url" "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/geoip.dat"
add_missing_option "justclash.settings.ipv6_enabled" "0"
add_missing_option "justclash.proxy.fake_ip_range6" "2001:2::1/48"
add_missing_option "justclash.proxy.geodata_mode" "0"
add_missing_option "justclash.proxy.geodata_autoupdate" "0"
add_missing_option "justclash.proxy.geodata_autoupdate_interval" "24"

if ! uci -q get justclash.settings.nft_ports_exclude >/dev/null; then
    uci add_list justclash.settings.nft_ports_exclude='6881'
fi

uci -q delete justclash.settings.mihomo_autoupdate
uci -q delete justclash.settings.mihomo_autoupdate_channel
uci -q delete justclash.settings.mihomo_cron_update_string
uci -q delete justclash.settings.skip_environment_checks

if [ "$(uci -q get justclash.proxy.fake_ip_ttl)" = "1" ]; then
    uci set justclash.proxy.fake_ip_ttl="60"
fi

if ! uci -q get justclash.proxy.sniffer_exclude_domain | grep -qF "*"; then
    uci add_list justclash.proxy.sniffer_exclude_domain='*'
fi

clean_fake_ip_list "fake_ip_exclude_domains"

# Remove deprecated fake_ip options from routing sections
for section in $(uci -q show justclash | sed -n 's/^justclash\.\(.*\)=proxies$/\1/p'); do
    uci -q delete "justclash.$section.fake_ip"
done
for section in $(uci -q show justclash | sed -n 's/^justclash\.\(.*\)=proxy_group$/\1/p'); do
    uci -q delete "justclash.$section.fake_ip"
done
uci -q delete justclash.direct_rules

for section in $(uci -q show justclash | sed -n 's/^justclash\.\(.*\)=proxy_provider$/\1/p'); do
    uci -q rename "justclash.$section.subscription_useragent_support=header_user_agent"
    uci -q rename "justclash.$section.subscription_authorization_support=header_authorization"
    uci -q rename "justclash.$section.subscription_hwid_support=header_hwid"
    uci -q rename "justclash.$section.age_public_key=header_age_public_key"

    hwid_val=$(uci -q get "justclash.$section.header_hwid")
    if [ "$hwid_val" = "1" ]; then
        uci set "justclash.$section.header_hwid=real"
    elif [ "$hwid_val" = "0" ]; then
        uci set "justclash.$section.header_hwid="
    fi
done

uci commit justclash || exit 1

exit 0

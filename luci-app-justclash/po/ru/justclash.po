msgid "Main service settings and scheduled tasks."
msgstr "Основные настройки сервиса и задачи по расписанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:19
msgid "Startup"
msgstr "Запуск"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:21
msgid "Wait for WAN connection on boot:"
msgstr "Ожидать подключения к интернету (WAN) при загрузке:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:22
msgid "Pause the startup process until the router establishes an active Internet connection (default route)."
msgstr "Приостановить процесс запуска до тех пор, пока роутер не установит активное подключение к интернету (маршрут по умолчанию)."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:26
msgid "Maximum wait time for WAN (s):"
msgstr "Максимальное время ожидания WAN (сек):"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:34
msgid "Maximum time in seconds to wait for WAN connection before proceeding with the current state."
msgstr "Максимальное время в секундах для ожидания подключения, прежде чем запуск продолжится в любом случае."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:37
msgid "Delay startup after boot:"
msgstr "Задержка после старта:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:38
msgid "Start the service a little later after the router boots. Useful if the router needs extra time to bring up storage, WAN, or other services."
msgstr "Запускать сервис чуть позже после включения роутера. Полезно, если устройству нужно больше времени для поднятия сети, накопителей или других служб."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:42
msgid "Startup delay:"
msgstr "Задержка запуска:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:52
msgid "Choose how many seconds to wait before the first service start after boot."
msgstr "Выберите, сколько секунд ждать до первого запуска сервиса после включения."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:54
msgid "Start time sync service:"
msgstr "Синхронизация времени:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:55
msgid "Start the built-in ntpd daemon so the system clock stays correct for secure connections. Without correct time, secure downloads and API connections may fail."
msgstr "Синхронизировать время, чтобы защищённые соединения работали корректно. При неверном времени могут не работать безопасные загрузки и API-подключения."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:60
msgid "Storage"
msgstr "Хранилище"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:62
msgid "Store Mihomo external rules persistently:"
msgstr "Внешние правила Mihomo в хранилище:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:63
msgid "Keep Mihomo external rule files in persistent router storage instead of temporary memory. Use this only if you need faster recovery after restart, because frequent writes can wear out built-in flash memory faster."
msgstr "Хранить файлы внешних правил Mihomo в постоянном хранилище роутера вместо временной памяти. Используйте это только если вам нужно более быстрое восстановление после перезапуска, потому что частые записи ускоряют износ встроенной flash-памяти."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:67
msgid "Store Mihomo cache persistently:"
msgstr "Кэш Mihomo в хранилище:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:68
msgid "Keep Mihomo cache data such as selected groups and fake-IP mappings in persistent router storage instead of temporary memory. Use this only if you need it, because frequent writes can wear out built-in flash memory faster."
msgstr "Хранить данные кэша Mihomo, такие как выбранные группы и соответствия fake-IP, в постоянном хранилище роутера вместо временной памяти. Используйте это только при необходимости, потому что частые записи ускоряют износ встроенной flash-памяти."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:73
msgid "Traffic rules"
msgstr "Правила трафика"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:75
msgid "Change DNS settings at startup:"
msgstr "Менять DNS при запуске:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:76
msgid "Update DNS settings automatically when the service starts. Use this if you want JustClash to manage dnsmasq DNS settings for you."
msgstr "Автоматически обновлять настройки DNS при запуске сервиса. Используйте это, если хотите, чтобы JustClash сам настраивал dnsmasq."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:80
msgid "Routing mode:"
msgstr "Режим маршрутизации:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:81
msgid "Select the traffic interception mode. 'Full Interception' intercepts all WAN traffic. 'Partial Interception' only intercepts Fake-IP domains and enabled IP CIDR rulesets, allowing direct traffic to bypass the proxy at kernel speed."
msgstr "Выберите режим перехвата трафика. «Полный перехват» перехватывает весь WAN-трафик. «Частичный перехват» перехватывает только домены Fake-IP и включённые наборы правил IP CIDR, позволяя прямому трафику обходить прокси на уровне ядра."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:82
msgid "Full Interception"
msgstr "Полный перехват"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:83
msgid "Partial Interception"
msgstr "Частичный перехват"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:87
msgid "Enable IPv6 support:"
msgstr "Включить поддержку IPv6:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:89
msgid "Allow Mihomo to process IPv6 traffic and resolve AAAA records via Fake-IP. If your WAN interface has no global IPv6 address at startup, this is silently ignored and the system operates in IPv4-only mode."
msgstr "Разрешить Mihomo обрабатывать IPv6-трафик и разрешать записи AAAA через Fake-IP. Если при запуске WAN-интерфейс не имеет глобального IPv6-адреса, настройка молча игнорируется и система работает только в режиме IPv4."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:96
msgid "Set traffic rules at startup:"
msgstr "Правила трафика при запуске:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:97
msgid "Create traffic rules so client devices use the proxy. Disable this only if you already manage traffic redirection rules outside JustClash."
msgstr "Создавать правила, чтобы устройства в сети использовали прокси. Отключайте только если уже настраиваете перенаправление трафика вне JustClash."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:101
msgid "Set router traffic rules at startup:"
msgstr "Правила трафика роутера при запуске:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:102
msgid "Create traffic rules so the router's own traffic also uses the proxy. Enable this only if you want updates, package installs, and other router traffic to go through the proxy too."
msgstr "Создавать правила, чтобы трафик самого роутера тоже шёл через прокси. Включайте это только если хотите направлять через прокси обновления, установку пакетов и другой трафик роутера."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:106
msgid "PBR priority:"
msgstr "Приоритет PBR:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:107
msgid "Priority for the policy routing rule that sends marked traffic to the local TPROXY table. Lower numbers run earlier."
msgstr "Приоритет правила policy routing, которое отправляет помеченный трафик в локальную таблицу TPROXY. Чем меньше число, тем раньше срабатывает правило."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:118
msgid "Router socket owner exclusions:"
msgstr "Исключения по владельцу сокета роутера:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:119
msgid "User names or numeric UIDs for router-originated sockets that should bypass proxy redirection rules. Useful for services like byedpi or https-dns-proxy that must reach the internet directly."
msgstr "Имена пользователей или числовые UID для сокетов, созданных самим роутером, которые должны обходить правила перенаправления через прокси. Полезно для сервисов вроде byedpi или https-dns-proxy, которым нужен прямой доступ в интернет."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:128
msgid "Router bypassed ports:"
msgstr "Исключенные порты роутера:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:129
msgid "Ports (destination or source, e.g., 22 or 80) for router traffic to bypass the proxy."
msgstr "Порты (назначения или источника, например, 22 или 80) для трафика роутера, которые будут идти в обход прокси."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:136
msgid "Client traffic interfaces:"
msgstr "Интерфейсы клиентского трафика:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:144
msgid "Select which interfaces receive client traffic that should be processed by JustClash. This is usually your LAN bridge; do not select WAN unless you know exactly why."
msgstr "Выберите интерфейсы, через которые поступает клиентский трафик, который должен обрабатываться JustClash. Обычно это LAN-мост; не выбирайте WAN без точного понимания зачем."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:147
msgid "Client bypassed ports:"
msgstr "Исключенные порты клиентов:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:148
msgid "Ports (destination or source, e.g., 22 or 80) for client traffic to bypass the proxy."
msgstr "Порты (назначения или источника, например, 22 или 80) для трафика клиентов, которые будут идти в обход прокси."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:155
msgid "Client bypassed MAC addresses:"
msgstr "Исключенные MAC-адреса клиентов:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:156
msgid "MAC addresses of clients that should bypass the proxy."
msgstr "MAC-адреса клиентов, трафик которых должен идти в обход прокси."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:163
msgid "Client bypassed IP addresses:"
msgstr "Исключенные IP-адреса клиентов:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:164
msgid "IP addresses or subnets (CIDR) of clients that should bypass the proxy."
msgstr "IP-адреса или подсети (CIDR) клиентов, трафик которых должен идти в обход прокси."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:171
msgid "Client QUIC traffic:"
msgstr "Клиентский QUIC:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:172
msgid "Choose how to handle QUIC traffic from devices on the selected client traffic interfaces. The selected mode decides whether this traffic is redirected or blocked."
msgstr "Выберите, как обрабатывать QUIC-трафик устройств в сети. Выбранный режим определяет, будет ли этот трафик перенаправляться или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:181
msgid "Client UDP DNS traffic:"
msgstr "Клиентский UDP DNS:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:182
msgid "Choose how to handle external UDP DNS requests from clients. Hijack redirects them to the router DNS service; local destinations and bypassed clients remain unchanged."
msgstr "Выберите, как обрабатывать внешние UDP DNS-запросы клиентов. Перехват перенаправляет их в DNS-службу роутера; локальные назначения и исключённые клиенты не изменяются."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:191
msgid "Client DoT traffic:"
msgstr "Клиентский DoT:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:192
msgid "Choose how to handle DoT traffic from devices on your network. The selected mode decides whether this traffic is redirected or blocked."
msgstr "Выберите, как обрабатывать DoT-трафик устройств в сети. Выбранный режим определяет, будет ли этот трафик перенаправляться или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:201
msgid "Client DoH traffic:"
msgstr "Клиентский DoH:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:202
msgid "Choose how to handle DoH traffic from devices on your network to well-known DoH IPs. The selected mode decides whether this traffic is redirected or blocked."
msgstr "Выберите, как обрабатывать DoH-трафик к известным DoH-серверам от устройств в сети. Выбранный режим определяет, будет ли этот трафик перенаправляться или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:211
msgid "Client DoQ traffic:"
msgstr "Клиентский DoQ:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:212
msgid "Choose how to handle DoQ traffic from devices on your network. The selected mode decides whether this traffic is redirected or blocked."
msgstr "Выберите, как обрабатывать DoQ-трафик устройств в сети. Выбранный режим определяет, будет ли этот трафик перенаправляться или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:221
msgid "Client NTP traffic:"
msgstr "Клиентский NTP:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:222
msgid "Choose how to handle time sync requests from devices on your network. The selected mode decides whether these requests are redirected, bypassed, or blocked."
msgstr "Выберите, как обрабатывать запросы времени от устройств в сети. Выбранный режим определяет, будут ли эти запросы перенаправляться, обходить прокси или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:231
msgid "Router NTP traffic:"
msgstr "NTP-трафик роутера:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:232
msgid "Choose how to handle time sync requests from the router itself. The selected mode decides whether these requests are redirected, bypassed, or blocked."
msgstr "Выберите, как обрабатывать запросы времени от самого роутера. Выбранный режим определяет, будут ли эти запросы перенаправляться, обходить прокси или блокироваться."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:242
msgid "Scheduled tasks"
msgstr "Задачи по расписанию"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:244
msgid "Restart Mihomo automatically:"
msgstr "Автоперезапуск Mihomo:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:245
msgid "Restart Mihomo on a schedule, for example once a week or once a day."
msgstr "Перезапускать Mihomo по расписанию, например раз в день или раз в неделю."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:249
msgid "Restart schedule:"
msgstr "Расписание перезапуска:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:255
msgid "Use a simple five-field cron schedule to choose when Mihomo should restart automatically. Each field accepts only * or one numeric value; lists, ranges, and steps are not supported."
msgstr "Используйте простое пятикомпонентное расписание cron, чтобы выбрать время автоматического перезапуска Mihomo. Каждое поле принимает только * или одно числовое значение; списки, диапазоны и шаги не поддерживаются."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:257 htdocs/luci-static/resources/view/justclash/pages/service.js:273
msgid "Invalid schedule format. Use: 'minute hour day month weekday' (for example, '0 3 * * 0')"
msgstr "Неверный формат расписания. Используйте: 'minute hour day month weekday' (например, '0 3 * * 0')"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:260
msgid "Update rules and databases automatically:"
msgstr "Автоматическое обновление правил и баз данных:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:261
msgid "Update rules and databases on a schedule, for example once a week or once a day."
msgstr "Обновлять правила и базы данных по расписанию, например, раз в неделю или раз в день."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:265
msgid "Update schedule:"
msgstr "Расписание обновлений:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:271
msgid "Use a simple five-field cron schedule to choose when rules and databases should update automatically. Each field accepts only * or one numeric value; lists, ranges, and steps are not supported."
msgstr "Используйте простое пятикомпонентное расписание cron, чтобы выбрать время автоматического обновления правил и баз данных. Каждое поле принимает только * или одно числовое значение; списки, диапазоны и шаги не поддерживаются."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:276
msgid "Enable scheduled work:"
msgstr "Включить работу по расписанию:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:277
msgid "Start and stop the proxy core on a daily schedule."
msgstr "Запуск и остановка ядра прокси по ежедневному расписанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:281
msgid "Start schedule:"
msgstr "Расписание запуска:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:287
msgid "Use a simple five-field cron schedule to choose when the core should start. Each field accepts only * or one numeric value; lists, ranges, and steps are not supported."
msgstr "Используйте простое пятикомпонентное расписание cron, чтобы выбрать время запуска ядра. Каждое поле принимает только * или одно числовое значение; списки, диапазоны и шаги не поддерживаются."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:289 htdocs/luci-static/resources/view/justclash/pages/service.js:300
msgid "Invalid schedule format."
msgstr "Неверный формат расписания."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:292
msgid "Stop schedule:"
msgstr "Расписание остановки:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:298
msgid "Use a simple five-field cron schedule to choose when the core should stop. Each field accepts only * or one numeric value; lists, ranges, and steps are not supported."
msgstr "Используйте простое пятикомпонентное расписание cron, чтобы выбрать время остановки ядра. Каждое поле принимает только * или одно числовое значение; списки, диапазоны и шаги не поддерживаются."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:304
msgid "External resources"
msgstr "Внешние ресурсы"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:306
msgid "Core update source:"
msgstr "Источник ядра:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:307
msgid "GitHub"
msgstr "GitHub"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:308
msgid "Custom URL"
msgstr "Пользовательский URL"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:309
msgid "Choose where Mihomo core should be downloaded from. 'GitHub' will automatically fetch the latest release, while 'Custom URL' allows downloading directly from your specified link."
msgstr "Выберите источник загрузки ядра Mihomo. «GitHub» автоматически загрузит последний выпуск, а «Пользовательский URL» позволит загрузить ядро непосредственно по указанной ссылке."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:314
msgid "GitHub repository:"
msgstr "Репозиторий GitHub:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:315
msgid "GitHub repository for Mihomo core updates. Must be in the format 'username/repo'. Example: 'MetaCubeX/mihomo'."
msgstr "Репозиторий GitHub для обновлений ядра Mihomo. Формат: 'пользователь/репозиторий'. Пример: 'MetaCubeX/mihomo'."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:322
msgid "Update channel:"
msgstr "Канал обновлений:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:326
msgid "Choose which release channel to use for Mihomo updates. Stable is safer, while newer channels may include newer features and newer bugs."
msgstr "Выберите канал для обновлений Mihomo. Стабильный канал безопаснее, а более новые каналы могут содержать и новые функции, и новые ошибки."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:332
msgid "Custom core base URL:"
msgstr "Пользовательский базовый URL ядра:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:333
msgid "Base URL of the server hosting the core files (similar to GitHub releases). The server MUST contain a 'version.txt' file and the corresponding 'mihomo-linux-arch-version.gz' archives. Example: 'https://example.com/mihomo/'"
msgstr "Базовый URL сервера с файлами ядра. На сервере ДОЛЖНЫ быть файл 'version.txt' и архивы 'mihomo-linux-arch-version.gz'. Пример: 'https://example.com/mihomo/'"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:343
msgid "Rulesets download URL:"
msgstr "URL для загрузки наборов правил:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:344
msgid "URL to download built-in rulesets from. Leave empty to use the default."
msgstr "URL для загрузки встроенных наборов правил. Оставьте поле пустым, чтобы использовать значение по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:351
msgid "Geosite download URL:"
msgstr "URL для загрузки Geosite:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:352
msgid "URL to download geosite.dat from. Leave empty to use the default."
msgstr "URL для загрузки geosite.dat. Оставьте пустым для использования значения по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:359
msgid "GeoIP download URL:"
msgstr "URL для загрузки GeoIP:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:360
msgid "URL to download geoip.dat from. Leave empty to use the default."
msgstr "URL для загрузки geoip.dat. Оставьте пустым для использования значения по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:367
msgid "Zashboard download URL:"
msgstr "URL для загрузки Zashboard:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:368
msgid "URL to download Zashboard dashboard from. Leave empty to use the default."
msgstr "URL для загрузки панели Zashboard. Оставьте пустым для использования по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:375
msgid "MetaCubeXD download URL:"
msgstr "URL загрузки MetaCubeXD:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:376
msgid "URL to download the MetaCubeXD dashboard from. Leave empty to use the default."
msgstr "URL для загрузки панели MetaCubeXD. Оставьте поле пустым, чтобы использовать значение по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:383
msgid "YACD-meta download URL:"
msgstr "URL для загрузки YACD-meta:"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:384
msgid "URL to download YACD-meta dashboard from. Leave empty to use the default."
msgstr "URL для загрузки панели YACD-meta. Оставьте пустым для использования по умолчанию."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:392
msgid "Kernel limits"
msgstr "Ограничения ядра"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:394
msgid "GOMEMLIMIT (Memory limit):"
msgstr "GOMEMLIMIT (Лимит памяти):"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:398
msgid "Limit the Go garbage collector memory usage (in MiB). Select a predefined limit or 0 to disable."
msgstr "Ограничить использование памяти сборщиком мусора Go (в МиБ). Выберите предустановленный лимит или 0 для отключения."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:403
msgid "GOGC (GC Target):"
msgstr "GOGC (цель GC):"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:407
msgid "Set the Go garbage collector target percentage. Lower values (e.g., 25 or 50) reduce RAM usage but increase CPU load. Select 0 for default (100)."
msgstr "Задайте целевой процент для сборщика мусора Go. Меньшие значения (например, 25 или 50) снижают использование ОЗУ, но увеличивают нагрузку на CPU. Выберите 0 для значения по умолчанию (100)."

#: htdocs/luci-static/resources/view/justclash/pages/service.js:413
msgid "GOMAXPROCS (CPU Threads):"
msgstr "GOMAXPROCS (потоки CPU):"

#: htdocs/luci-static/resources/view/justclash/pages/service.js:417
msgid "Limit the number of CPU threads Mihomo can use. Set to 1 or 2 on multi-core routers to leave CPU available for system routing. Select 0 for default (all cores)."
msgstr "Ограничьте количество потоков CPU, доступных Mihomo. На многоядерных маршрутизаторах выберите 1 или 2, чтобы оставить ресурсы CPU для системной маршрутизации. Выберите 0 для значения по умолчанию (все ядра)."


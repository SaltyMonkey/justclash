{
    "luci-app-justclash": {
        "description": "Grant UCI and RPC access to LuCI app justclash",
        "read": {
            "file": {
                "/etc/justclash/rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/block.rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/user.rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/user.block.rulesets.txt": [
                    "read"
                ]
            },
            "uci": [
                "justclash"
            ],
            "ubus": {
                "system": [
                    "board"
                ],
                "justclash-core": [
                    "status",
                    "check",
                    "config_show",
                    "logs"
                ]
            }
        },
        "write": {
            "file": {
                "/etc/justclash/user.rulesets.txt": [
                    "write"
                ],
                "/etc/justclash/user.block.rulesets.txt": [
                    "write"
                ]
            },
            "uci": [
                "justclash"
            ],
            "ubus": {
                "justclash-core": [
                    "start",
                    "stop",
                    "restart",
                    "enable",
                    "disable",
                    "hardware_id",
                    "config_show_unsafe",
                    "resources_update"
                ]
            }
        }
    }
}

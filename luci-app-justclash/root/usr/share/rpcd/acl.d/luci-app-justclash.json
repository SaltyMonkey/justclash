{
    "luci-app-justclash": {
        "description": "Grant UCI and RPC access to LuCI app justclash",
        "read": {
            "file": {
                "/etc/justclash/rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/block.rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/user.rulesets.txt": [
                    "read"
                ],
                "/etc/justclash/user.block.rulesets.txt": [
                    "read"
                ]
            },
            "uci": [
                "justclash"
            ],
            "ubus": {
                "system": [
                    "board"
                ],
                "justclash": [
                    "status",
                    "diag_redacted",
                    "diag_mihomo_config",
                    "diag_service_config",
                    "systemlogs"
                ]
            }
        },
        "write": {
            "file": {
                "/etc/justclash/user.rulesets.txt": [
                    "write"
                ],
                "/etc/justclash/user.block.rulesets.txt": [
                    "write"
                ]
            },
            "uci": [
                "justclash"
            ],
            "ubus": {
                "justclash": [
                    "start",
                    "stop",
                    "restart",
                    "diag_mihomo_config_unsafe",
                    "diag_service_config_unsafe",
                    "update_core",
                    "update_rulesets"
                ]
            }
        }
    }
}
